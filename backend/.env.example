NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database and authentication
MONGODB_URI=mongodb://localhost:27017/atlas_travel
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=1

# LLM provider
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional embeddings / future vector DB
PINECONE_API_KEY=your_pinecone_api_key
HUGGINGFACE_API_KEY=optional_future_embedding_api_key

# Email delivery
# Recommended for production: Resend. SMTP support can be added separately if needed.
EMAIL_FROM=ATLAS <no-reply@yourdomain.com>
RESEND_API_KEY=your_resend_api_key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=12

# Request and upload limits
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=12582912
MAX_USER_DOCUMENTS=100
MAX_USER_STORAGE_BYTES=157286400
MAX_DOCUMENT_TEXT_CHARS=250000

# Travel APIs
GOOGLE_API_KEY=your_google_maps_or_places_key
GOOGLE_MAPS_API_KEY=your_google_maps_or_places_key
GOOGLE_PLACES_API_KEY=your_google_places_key
OPEN_WEATHER_KEY=your_openweather_key
NEWS_API_KEY=your_newsapi_key
YELP_API_KEY=your_yelp_key
