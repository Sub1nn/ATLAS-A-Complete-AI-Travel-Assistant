# ATLAS backend environment example. Copy this file to backend/.env for local development.
# Never commit or share real .env files. Generate JWT_SECRET with: openssl rand -hex 64

NODE_ENV=development
# Use staging only for isolated non-production deployments. Production must use production.
DEPLOYMENT_ENV=development
# Keep required for normal deployments. Optional is for a controlled development/staging public preview only.
EMAIL_VERIFICATION_MODE=required
# Disable when staging uses Mailtrap Sandbox, because sandbox messages are not delivered to visitors.
PASSWORD_RECOVERY_ENABLED=true
# Preview accounts retain chats and documents for this many days (minimum 30).
PUBLIC_PREVIEW_DATA_RETENTION_DAYS=30
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Database and authentication
# Host-run development against the MongoDB container published on localhost.
# directConnection prevents the driver from resolving Docker's internal "mongo" hostname.
MONGODB_URI=mongodb://127.0.0.1:27017/atlas_travel?replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=1
MONGODB_AUTO_INDEX=false
MONGODB_TRANSACTIONS=true
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=atlas_refresh
CSRF_COOKIE_NAME=atlas_csrf
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_REUSE_GRACE_MS=10000
AUTH_MAX_FAILED_LOGIN_DELAY_MS=2000
PRIVACY_POLICY_VERSION=2026-06-22
TERMS_VERSION=2026-06-22
LEGAL_OPERATOR_NAME=replace_with_legal_operator_name
PRIVACY_CONTACT_EMAIL=replace_with_privacy_contact_email
LEGAL_JURISDICTION=replace_with_governing_jurisdiction
PRIVACY_LAWFUL_BASIS=replace_with_reviewed_lawful_basis
PRIVACY_TRANSFER_SAFEGUARDS=replace_with_reviewed_transfer_safeguards
PRIVACY_SUPERVISORY_AUTHORITY=replace_with_competent_data_protection_authority
DEFAULT_DATA_RETENTION_DAYS=365
METRICS_TOKEN=replace_with_a_strong_random_metrics_token
ERROR_REPORTING_WEBHOOK_URL=

# LLM provider
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Fast schema-constrained intent and tool planner.
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
# Higher-quality schema-constrained user-facing response composer.
GROQ_RESPONSE_MODEL=openai/gpt-oss-120b
# One controlled provider fallback; deterministic ATLAS rendering remains the final fallback.
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK_ENABLED=true
# Optional LLM planner for intent/date/tool orchestration. Set false to use deterministic planner only.
ATLAS_LLM_PLANNER_ENABLED=true
# Uses native strict JSON Schema with the GPT-OSS planner model.
ATLAS_LANGCHAIN_PLANNER_ENABLED=true
# Structured LangChain response composition for requests that do not have a deterministic live-data renderer.
ATLAS_LANGCHAIN_RESPONSE_ENABLED=true

# Agent orchestration and observability
# Shadow mode executes LangGraph alongside the current response pipeline without changing user-visible answers.
ATLAS_AGENT_SHADOW_MODE=false
ATLAS_AGENT_GRAPH_ENABLED=false
# Enables the conditional supervisor/specialist workflow. Keep false until its evaluation suite passes.
ATLAS_AGENT_HYBRID_ENABLED=false
ATLAS_AGENT_CANARY_PERCENT=0
ATLAS_AGENT_FALLBACK_ENABLED=true
ATLAS_AGENT_REQUEST_TIMEOUT_MS=60000
ATLAS_AGENT_MAX_SPECIALISTS=6
# Runs one bounded evidence-aware critic pass after deterministic verification.
ATLAS_AGENT_RESPONSE_REVIEW_ENABLED=false
ATLAS_AGENT_SHADOW_TIMEOUT_MS=1500
ATLAS_AGENT_CHECKPOINT_TTL_SECONDS=604800
ATLAS_AGENT_CHECKPOINT_DB=atlas_travel
# Tests use memory unless explicitly set to mongodb by the replica-set integration suite.
ATLAS_AGENT_CHECKPOINT_BACKEND=mongodb
# Tracing is optional. Store the real key only in a secret manager or untracked .env file.
LANGSMITH_TRACING=false
# ATLAS mirrors LANGSMITH_TRACING into this private, sanitized tracer switch at runtime.
ATLAS_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas-travel-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_CONNECTION_CHECK=true
LANGSMITH_TRACING_SAMPLING_RATE=0.1
LANGSMITH_OMIT_RUNTIME_INFO=true
LANGCHAIN_CALLBACKS_BACKGROUND=true

# Travel APIs
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_platform_server_key
OPEN_WEATHER_KEY=your_openweather_key
OPENWEATHER_API_KEY=your_openweather_key
NEWS_API_KEY=your_newsapi_key
YELP_API_KEY=your_yelp_key

# Email delivery. Resend is the production default.
EMAIL_TRANSPORT=resend
EMAIL_FROM=ATLAS <no-reply@yourdomain.com>
RESEND_API_KEY=your_resend_api_key
# Mailtrap Sandbox is accepted only with EMAIL_TRANSPORT=mailtrap_sandbox and DEPLOYMENT_ENV=staging.
# Sandbox messages are captured in Mailtrap and are never delivered to real recipient inboxes.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_SECURE=false
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# Optional Redis. In production this should point to managed Redis/ElastiCache/Memorystore.
# If REDIS_URL is omitted, rate limiting uses process-local memory and API cache is no-op in production.
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_GEOCODE_TTL_SECONDS=604800
CACHE_WEATHER_TTL_SECONDS=900
CACHE_PLACES_TTL_SECONDS=300
CACHE_TIMEZONE_TTL_SECONDS=86400
CACHE_DIRECTIONS_TTL_SECONDS=60
CACHE_YELP_TTL_SECONDS=1800
CACHE_NEWS_TTL_SECONDS=2700
CACHE_ADVISORY_TTL_SECONDS=1800
CACHE_MEMORY_MAX_ITEMS=1000
PLACE_SEARCH_MAX_CALLS=5
PLACE_SEARCH_CONCURRENCY=3
# Optional fallback country appended only after a direct geocode misses, for example Finland.
LOCATION_COUNTRY_HINT=
LOCATION_CACHE_MAX_ITEMS=1000

# Rate limiting
# In NODE_ENV=development, HTTP and daily usage limits are bypassed unless this is true.
ENFORCE_DEVELOPMENT_LIMITS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_RESEND_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RESEND_RATE_LIMIT_MAX_REQUESTS=3
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=12
DAILY_CHAT_REQUEST_LIMIT=50
DAILY_PROVIDER_CALL_LIMIT=120
DAILY_LLM_CALL_LIMIT=60
GLOBAL_DAILY_PROVIDER_CALL_LIMIT=10000
GLOBAL_DAILY_LLM_CALL_LIMIT=5000
GLOBAL_USAGE_ALERT_THRESHOLD=0.8
CHAT_MAX_TOOL_GROUPS=6
CHAT_TOOL_CONCURRENCY=2
CHAT_MAX_MULTI_DESTINATION_TOOL_CALLS=12
CHAT_REQUEST_LEASE_MS=600000
CONVERSATION_LEASE_MS=300000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
PROVIDER_CIRCUIT_COOLDOWN_MS=60000
DOCUMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=600000
DOCUMENT_UPLOAD_RATE_LIMIT_MAX_REQUESTS=10

# Request and upload limits
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=12582912
MAX_USER_DOCUMENTS=100
MAX_USER_STORAGE_BYTES=157286400
MAX_DOCUMENT_TEXT_CHARS=250000
MAX_DOCUMENT_PAGES=300
DOCUMENT_EXTRACTION_TIMEOUT_MS=60000
DOCUMENT_EXTRACTION_MEMORY_MB=256
DOCUMENT_MAX_PROCESSING_ATTEMPTS=4
DOCUMENT_LEASE_MS=300000
DOCUMENT_QUEUE_POLL_MS=2000
ACCOUNT_DELETION_MAX_ATTEMPTS=20
ACCOUNT_DELETION_LEASE_MS=600000
ACCOUNT_DELETION_POLL_MS=2000
DOCUMENT_DELETION_MAX_ATTEMPTS=12
DOCUMENT_DELETION_LEASE_MS=300000
DOCUMENT_DELETION_POLL_MS=2000
OPERATION_LEASE_MS=300000
WORKERS_REQUIRED=false
REQUIRED_WORKERS=documents,privacy,retention
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_STALE_MS=45000
WORKER_MAX_QUEUE_AGE_SECONDS=300
RETENTION_INTERVAL_MS=86400000

# Optional Pinecone semantic document retrieval.
# Recommended mode for this app: inference. It uses Pinecone Inference to create real
# llama-text-embed-v2 embeddings, then stores/query vectors in a Pinecone index.
# Create the index once with: npm run pinecone:setup
PINECONE_ENABLED=false
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=atlas-documents
# Optional. Use this if you want to target the index host directly instead of resolving by name.
PINECONE_INDEX_HOST=
PINECONE_INDEX_MODE=inference
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_EMBEDDING_DIMENSIONS=1024
PINECONE_EMBEDDING_TRUNCATE=END
PINECONE_NAMESPACE_PREFIX=atlas-user
PINECONE_TOP_K=8
PINECONE_MIN_SCORE=0.35
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_AUTO_CREATE_INDEX=false

# Google Maps setup note:
# ATLAS uses Places API (New) and Routes API v2, not their legacy equivalents.
# Enable the required Google Maps Platform APIs in Google Cloud.
# Use GOOGLE_MAPS_SERVER_API_KEY only for backend/server requests.
