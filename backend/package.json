    "i18n-iso-countries": "^7.14.0",
    "jsonwebtoken": "^9.0.2",
    "langsmith": "^0.8.7",
    "mammoth": "^1.8.0",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
