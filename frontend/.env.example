# ATLAS frontend environment example. Copy to frontend/.env for local Vite development.
# For Docker same-domain deployment, use /api so Nginx proxies requests to the backend.
VITE_API_BASE_URL=http://localhost:4000/api
# Optional browser-only key for Maps JavaScript API. Do not put GOOGLE_MAPS_SERVER_API_KEY here.
VITE_GOOGLE_MAPS_API_KEY=
VITE_CHAT_TIMEOUT_MS=100000
VITE_HEALTH_TIMEOUT_MS=5000
VITE_PUBLIC_URL=http://localhost:5173/
VITE_SOURCE_MAPS=false
